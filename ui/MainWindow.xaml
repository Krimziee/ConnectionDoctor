<!--
    Standalone Connection Doctor window: an empty frame that shows Page.xaml.
    (In Krimz's Toolkit the same page is shown in the Connection Doctor tab.)
-->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Connection Doctor" Width="1180" Height="880" MinWidth="980" MinHeight="740"
        WindowStartupLocation="CenterScreen" Background="#1C1C1C"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14" Foreground="#F3F3F3"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
</Window>
