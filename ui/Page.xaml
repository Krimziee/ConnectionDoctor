<!--
    Connection Doctor page. Used by the standalone window (MainWindow.xaml) and by
    the Connection Doctor tab in Krimz's Toolkit. The live monitor fills the top
    half; the optional tests and the event list sit underneath. Controls with
    x:Name are found and filled in by modules\Ui.ps1. It keeps its own layout and
    styles (below); colors match the shared Theme.xaml.
-->
<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#1C1C1C" Foreground="#F3F3F3"
             FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14">

    <UserControl.Resources>
        <SolidColorBrush x:Key="Surface"      Color="#272727"/>
        <SolidColorBrush x:Key="Surface2"     Color="#2F2F2F"/>
        <SolidColorBrush x:Key="SurfaceHover" Color="#383838"/>
        <SolidColorBrush x:Key="Line"         Color="#3A3A3A"/>
        <SolidColorBrush x:Key="Muted"        Color="#A6A6A6"/>
        <SolidColorBrush x:Key="Accent"       Color="#4CA6FF"/>

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#F3F3F3"/>
            <Setter Property="Background" Value="{StaticResource Surface2}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceHover}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource Surface2}"/>
            <Setter Property="Foreground" Value="#F3F3F3"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="CaretBrush" Value="#F3F3F3"/>
            <Setter Property="Padding" Value="6,3"/>
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Surface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20,14,20,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- header -->
            <RowDefinition Height="Auto"/>   <!-- verdict -->
            <RowDefinition Height="*" MinHeight="190"/>  <!-- graph -->
            <RowDefinition Height="Auto"/>   <!-- tiles -->
            <RowDefinition Height="Auto"/>   <!-- wi-fi -->
            <RowDefinition Height="270"/>    <!-- tests + events -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Connection Doctor" FontSize="22" FontWeight="SemiBold"/>
                    <TextBlock x:Name="VersionText" Foreground="{StaticResource Muted}" FontSize="12" Margin="10,0,0,3" VerticalAlignment="Bottom"/>
                </StackPanel>
                <TextBlock x:Name="ConnText" Foreground="{StaticResource Muted}" FontSize="13" Margin="0,2,0,0"/>
            </StackPanel>
            <Button x:Name="PauseButton" Grid.Column="1" Content="Pause" HorizontalContentAlignment="Center" MinWidth="96" VerticalAlignment="Center"/>
        </Grid>

        <!-- Verdict -->
        <Border x:Name="VerdictBorder" Grid.Row="1" Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Ellipse x:Name="VerdictDot" Width="14" Height="14" Fill="#808080" VerticalAlignment="Top" Margin="0,6,14,0"/>
                <StackPanel Grid.Column="1">
                    <TextBlock x:Name="VerdictTitle" Text="Measuring..." FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock x:Name="VerdictDetail" Foreground="{StaticResource Muted}" FontSize="13" TextWrapping="Wrap" Margin="0,3,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Graph -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="6,8,12,6">
            <Grid>
                <Canvas x:Name="GraphCanvas" ClipToBounds="True" Background="Transparent"/>
                <TextBlock Text="Ping over the last 2 minutes - click a tile below to hide or show its line"
                           Foreground="#707070" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,0,0"/>
            </Grid>
        </Border>

        <!-- One tile per target -->
        <UniformGrid x:Name="TilesGrid" Grid.Row="3" Rows="1" Margin="-4,10,-4,0"/>

        <!-- Wi-Fi strip, only on Wi-Fi -->
        <Border x:Name="WifiStrip" Grid.Row="4" Style="{StaticResource Card}" Padding="14,8" Margin="0,10,0,0" Visibility="Collapsed">
            <TextBlock x:Name="WifiText" FontSize="13" TextWrapping="Wrap"/>
        </Border>

        <!-- Tests and events -->
        <Grid Grid.Row="5" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}" Padding="14,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <TextBlock Text="TESTS" Foreground="{StaticResource Muted}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock Text="Your internet plan (optional):" Foreground="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBox x:Name="PlanBox" Width="60" FontSize="12"/>
                            <TextBlock Text="Mbps" Foreground="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Grid>
                    <UniformGrid Grid.Row="1" Rows="1" Margin="-4,8,-4,8">
                        <Button x:Name="BtnDetails" Margin="4,0">
                            <StackPanel>
                                <TextBlock Text="Connection Details" FontWeight="SemiBold" FontSize="13"/>
                                <TextBlock Text="Cable or Wi-Fi, link speed" Foreground="{StaticResource Muted}" FontSize="11"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="BtnDns" Margin="4,0">
                            <StackPanel>
                                <TextBlock Text="DNS Test" FontWeight="SemiBold" FontSize="13"/>
                                <TextBlock Text="About 10 seconds" Foreground="{StaticResource Muted}" FontSize="11"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="BtnRoute" Margin="4,0">
                            <StackPanel>
                                <TextBlock Text="Route Check" FontWeight="SemiBold" FontSize="13"/>
                                <TextBlock Text="About 1 minute" Foreground="{StaticResource Muted}" FontSize="11"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="BtnLoad" Margin="4,0">
                            <StackPanel>
                                <TextBlock Text="Lag Under Load" FontWeight="SemiBold" FontSize="13"/>
                                <TextBlock Text="Uses up to 100 MB" Foreground="{StaticResource Muted}" FontSize="11"/>
                            </StackPanel>
                        </Button>
                    </UniformGrid>
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="ResultsPanel">
                            <TextBlock x:Name="ResultsHint" Text="Test results appear here. The live monitor keeps running while a test runs."
                                       Foreground="#808080" FontSize="12" TextWrapping="Wrap"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="14,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="EVENTS" Foreground="{StaticResource Muted}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="EventsPanel"/>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
